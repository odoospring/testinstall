<odoo>
  <record id="view_order_form_edi_info" model="ir.ui.view">
    <field name="name">sale.order.form.edi.info</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

      <!-- Header fields, right-hand column -->
      <xpath expr="//group[@name='order_details']" position="inside">
        <field name="edi_order_number"/>
        <field name="edi_ship_open_date"/>
        <field name="edi_ship_close_date"/>
      </xpath>

      <!-- New tab -->
      <xpath expr="//notebook" position="inside">
        <page string="Spring Systems EDI info" name="spring_edi_info">
          <group>
            <group>
              <field name="edi_mark_for_location"/>
              <field name="edi_order_message"/>
            </group>
            <group>
              <field name="edi_order_id"/>
              <field name="edi_division"/>
              <field name="edi_department"/>
              <field name="edi_merchandise_type"/>
              <field name="edi_currency_code"/>
              <field name="edi_shipping_pay_method"/>
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <!-- Make EDI orders searchable from the list view search bar -->
  <record id="view_sales_order_filter_edi_info" model="ir.ui.view">
    <field name="name">sale.order.search.edi.info</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sales_order_filter"/>
    <field name="arch" type="xml">
      <field name="partner_id" position="after">
        <field name="edi_order_number"/>
        <field name="edi_order_id"/>
      </field>
    </field>
  </record>
</odoo>
